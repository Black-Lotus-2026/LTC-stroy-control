# Скопируйте в .env и при необходимости поправьте.
# Значения ниже — те, с которыми работает docker compose.

ENVIRONMENT=docker
DEBUG=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=stroy
POSTGRES_PASSWORD=stroy
POSTGRES_DB=stroy_control

REDIS_HOST=redis
REDIS_PORT=6379

# true — задачи выполняются синхронно, без брокера и воркера.
CELERY_EAGER=false

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/var/storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

# LLM-формулировки для отчётов. Без ключа работает безопасный template fallback.
REPORT_LLM_ENABLED=false
REPORT_LLM_MODEL=gpt-5.5
REPORT_LLM_REASONING_EFFORT=low
REPORT_LLM_TIMEOUT_SECONDS=30
REPORT_LLM_MAX_RETRIES=2
OPENAI_API_KEY=
