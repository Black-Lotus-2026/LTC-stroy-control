# Скопируйте в .env и при необходимости поправьте.
# Значения ниже — те, с которыми работает docker compose.

ENVIRONMENT=docker
DEBUG=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=stroy
POSTGRES_PASSWORD=stroy
POSTGRES_DB=stroy_control

REDIS_HOST=redis
REDIS_PORT=6379

# true — задачи выполняются синхронно, без брокера и воркера.
CELERY_EAGER=false

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/var/storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

VIOLATION_EVALUATION_WINDOW_SECONDS=30
