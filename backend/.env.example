# Скопируйте в .env и при необходимости поправьте.
# Значения ниже — те, с которыми работает docker compose.

ENVIRONMENT=docker
DEBUG=true

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=stroy
POSTGRES_PASSWORD=stroy
POSTGRES_DB=stroy_control

REDIS_HOST=redis
REDIS_PORT=6379

# true — задачи выполняются синхронно, без брокера и воркера.
CELERY_EAGER=false

STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/app/var/storage
STORAGE_PUBLIC_URL=http://localhost:8000/media

# LLM-формулировки для отчётов. Без ключа работает безопасный template fallback.
REPORT_LLM_ENABLED=false
REPORT_LLM_MODEL=gpt-5.5
REPORT_LLM_REASONING_EFFORT=low
REPORT_LLM_TIMEOUT_SECONDS=30
REPORT_LLM_MAX_RETRIES=2
OPENAI_API_KEY=

# Агент ПОС/ППР: openai_compatible (по умолчанию OpenRouter) или gigachat.
# Текст выбранных фрагментов передаётся выбранному провайдеру при анализе.
DOCUMENT_LLM_PROVIDER=openai_compatible
DOCUMENT_LLM_BASE_URL=https://openrouter.ai/api/v1
DOCUMENT_LLM_MODEL=openai/gpt-4o-mini
# Отдельный ключ или OPENROUTER_API_KEY ниже.
DOCUMENT_LLM_API_KEY=
# Для GigaChat-3-Ultra нужен ключ авторизации API физлица (PERS).
# Проверенный корневой сертификат НУЦ Минцифры включён в backend/certs.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca.pem
DOCUMENT_LLM_TIMEOUT_SECONDS=120
DOCUMENT_LLM_MAX_CHUNKS=12

VIOLATION_EVALUATION_WINDOW_SECONDS=30

# Необязательно: email в дополнение к алертам внутри сервиса.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Управленческий слой. Ключ только в backend/.env (игнорируется Git).
# Без ключа роли пропускаются явно, калькулятор остаётся доступен.
OPENROUTER_API_KEY=
# Нужен обычный inference API key. Management/provisioning key не вызывает модели.
OPENROUTER_MODEL=openai/gpt-4o-mini
MANAGEMENT_RUN_TIMEOUT_SECONDS=90
MANAGEMENT_QUEUE_TIMEOUT_SECONDS=300

# Единственная модель YOLO. Отсутствие/неверный SHA даёт 503, без замены модели.
YOLO_WEIGHTS_PATH=/app/weights/construction-yolov8m-v2.pt
CONSTRUCTION_IMGSZ=960
CONSTRUCTION_CONFIDENCE=0.5
# Фото: VLM вызывается только после успешного пустого результата YOLO.
PHOTO_VLM_ENABLED=true
PHOTO_VLM_MODEL=openai/gpt-4o-mini
PHOTO_VLM_TIMEOUT_SECONDS=20

# Explicit operational opt-in. Event candidates still require human review.
CONSTRUCTION_POLICY=shadow
CONSTRUCTION_APPROVED_CLASSES=[]

# Приватные оригиналы ППР: каталог вне STORAGE_LOCAL_ROOT и публичного /media.
PPR_STORAGE_ROOT=./var/documents
MAX_PPR_UPLOAD_BYTES=52428800

# Модель автономного разбора из docker-compose.yml.
PPR_ANALYSIS_MODEL=qwen2.5:7b
PPR_RENDERER_EXECUTABLE=libreoffice

# Автономный разбор: ollama + модель, заданная в compose (без внешнего ключа).
PPR_PROVIDER=ollama
# Для внешнего провайдера: PPR_PROVIDER=openrouter и OPENROUTER_API_KEY.
PPR_OLLAMA_URL=http://ppr_llm:11434
# Эталоны камер хранятся вне публичного /media. RTSP требует доверенной сети.
CAMERA_VIEW_STORAGE_ROOT=./var/camera-views-private
CAMERA_ALLOW_RTSP_CAPTURE=false
CAMERA_ALLOWED_NETWORKS=[]

# Публикует реальные live-камеры только в shared_demo; пароль только на сервере.
MYVMS_DEMO_ENABLED=false
MYVMS_BASE_URL=http://vms.example.org:9786
MYVMS_USERNAME=
MYVMS_PASSWORD=
# Нумерация каналов с нуля: Camera 2 и Camera 3.
MYVMS_DEMO_CHANNELS=[1,2]
